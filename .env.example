# AI Cost Auditor — Environment Variables
# Copy to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# REQUIRED
# =============================================================================

# API authentication key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
API_KEY=your-secret-api-key-here

# =============================================================================
# STORAGE (defaults work for local Docker development)
# =============================================================================

# Backend: "local" (default) or "cloudflare" (production)
STORAGE_BACKEND=local

# SQLite database path (local only)
DATABASE_URL=sqlite:////app/data/auditor.db

# Local file storage path
STORAGE_PATH=/app/data/uploads

# =============================================================================
# LLM ANALYST (optional — disabled by default)
# =============================================================================

# Enable LLM-assisted analysis (default: false)
# When enabled, structured findings are sent to LLM for explanation only.
# Financial calculations are never performed by the LLM.
LLM_ENABLED=false

# OpenAI API key (required if LLM_ENABLED=true and LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...

# Anthropic API key (required if LLM_ENABLED=true and LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...

# LLM provider: "openai" (default) or "anthropic"
# LLM_PROVIDER=openai

# LLM model to use for explanations (not financial calculations)
# LLM_MODEL=gpt-4o-mini

# =============================================================================
# LOGGING
# =============================================================================

LOG_LEVEL=INFO
