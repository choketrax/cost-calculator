# AgentGateway environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# ── AgentGateway API key (agents must send this in x-api-key header) ──
AGW_API_KEY=your-agentgateway-api-key-here

# ── LLM Provider keys (only add what you use) ──
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIza...

# ── Optional: Portkey fallback ──
PORTKEY_API_KEY=

# ── Optional: Postgres MCP server ──
POSTGRES_URL=postgresql://user:pass@host:5432/db
